{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "paths": {
      "@server/*": ["./server/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/trpc/router.ts",
    "server/trpc/routers/**/*.ts",
    "server/trpc/trpc.ts",
    "server/trpc/context.ts",
    "tests/e2e/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
