# Connection to Postgres
DATABASE_URL=postgres://cloudcode:cloudcode@localhost:5432/cloudcode

# Where secrets.key, sandbox workspaces, and GitHub App keys live
DATA_DIR=./data

# Public URL used in GitHub App callbacks + manifest origin
PUBLIC_URL=http://localhost:3000

# Optional: bootstrap admin password on first run
# ADMIN_PASSWORD_BOOTSTRAP=changeme

# Base image for sandbox containers (Phase 2)
SANDBOX_BASE_IMAGE=cloud-code-sandbox:dev

# Docker network shared between app + sandboxes (Phase 2)
DOCKER_NETWORK=cloud-code-net

# Server port
PORT=3000

NODE_ENV=development

# --- Phase 4: built-in agent (OpenCode) -----------------------------------
# Provider keys are normally stored encrypted via the Settings UI. These
# env vars exist as a *bootstrap* convenience: on first start, if a key is
# present here and no DB row exists for that provider, it is encrypted
# and persisted, then the env var can be removed. They are NEVER exposed
# to sandbox containers as-is — the AgentService reads from the encrypted
# secrets store and injects only the relevant key into `opencode serve`.
#
# Anthropic-compatible base URLs that point at `localhost` / `127.0.0.1`
# are auto-rewritten to `host.docker.internal` when injected into a
# sandbox container so they reach the host loopback (Docker Desktop only;
# on Linux operators may need `--add-host` config). Leave the URL blank
# to use the official Anthropic endpoint.
ANTHROPIC_API_KEY_BOOTSTRAP=
ANTHROPIC_BASE_URL_BOOTSTRAP=
# OPENAI_API_KEY_BOOTSTRAP=
# OPENAI_BASE_URL_BOOTSTRAP=

# --- Local environments ----------------------------------------------------
# Shared secret the orchestrator presents to identity when minting an
# env-auth token for a new container env. In v1 both routers live in the
# same process so this is a self-check; keep the wiring mirrored so we can
# split the processes later without an API change.
CC_SERVICE_CREDENTIAL=replace-me-long-random-string
