# Connection to Postgres
DATABASE_URL=postgres://cloudcode:cloudcode@localhost:5432/cloudcode

# Where secrets.key, sandbox workspaces, and GitHub App keys live
DATA_DIR=./data

# Public URL used in GitHub App callbacks + manifest origin
PUBLIC_URL=http://localhost:3000

# Optional: bootstrap admin password on first run
# ADMIN_PASSWORD_BOOTSTRAP=changeme

# Base image for sandbox containers (Phase 2)
SANDBOX_BASE_IMAGE=cloud-code-sandbox:dev

# Docker network shared between app + sandboxes (Phase 2)
DOCKER_NETWORK=cloud-code-net

# Server port
PORT=3000

NODE_ENV=development
