{
  "name": "cloud-code-desktop",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup",
    "dev": "npm run build && electron dist/main.js",
    "package:mac": "npm run build && electron-packager . \"Cloud Code Desktop\" --platform=darwin --arch=arm64 --out=release --overwrite --ignore='^/src($|/)' --ignore='^/dist/.*\\.map$'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@samdesota/webframe": "^0.1.2",
    "electron": "^32.3.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
