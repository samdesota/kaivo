{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "outDir": "test-app/dist",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["test-app/**/*.ts", "src/**/*.ts", "sqlite/src/**/*.ts"],
  "exclude": ["node_modules", "test-app/dist", "dist", "sqlite/dist"]
}
