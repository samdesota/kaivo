# Place this on the host at /etc/caddy/Caddyfile.
# Reload with: systemctl reload caddy

{
    email admin@438d.xyz

    # Tailscale binds a specific IPv6 address on :443; binding [::]:443
    # collides. Pin Caddy to the public IPv4 only.
    default_bind 161.35.136.150

    on_demand_tls {
        ask http://127.0.0.1:3000/internal/ask-tls
    }
}

code.438d.xyz {
    encode gzip
    reverse_proxy 127.0.0.1:3000
}

*.preview.438d.xyz {
    encode gzip
    tls {
        on_demand
    }
    reverse_proxy 127.0.0.1:3000
}
