{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "noEmit": true,
    "paths": {
      "@server/*": ["./server/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "tsup.config.ts",
    "playwright.config.ts",
    "eslint.config.js"
  ],
  "exclude": ["node_modules", "dist"]
}
